{
  "name": "dashboard-indikator-bps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard Indikator Strategis BPS Kabupaten Lombok Tengah",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc --noEmit && vite build",
    "build:api": "npm --prefix server run build",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "npm --prefix server run typecheck",
    "test:data": "node scripts/check-data-integrity.mjs",
    "test": "node scripts/fullstack-smoke.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "db:generate": "npm --prefix server run db:generate",
    "db:push": "npm --prefix server run db:push",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",
    "preview": "vite preview",
    "extract:data": "node scripts/extract-bps-data.cjs",
    "guide:screens": "node scripts/capture-guide-screens.mjs",
    "guide:docx": "node scripts/generate-user-guide.mjs",
    "capstone:report": "node scripts/generate-capstone-report.mjs",
    "capstone:pptx": "node scripts/generate-capstone-presentation.mjs",
    "capstone:bab1": "node scripts/generate-capstone-bab1-pptx.mjs",
    "capstone:docs": "node scripts/generate-capstone-report.mjs && node scripts/generate-capstone-presentation.mjs",
    "capstone:install-polished": "node scripts/install-polished-capstone.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "docx": "^9.7.1",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
